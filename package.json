{
  "name": "@adobe/reactor-packager",
  "version": "5.0.0-beta.1",
  "description": "Command line utility for packaging a Tags extension into a zip file.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "author": {
    "name": "Adobe Systems",
    "url": "http://adobe.com",
    "email": "reactor@adobe.com"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "prepublishOnly": "npm run build",
    "test": "npm run build && npm run package-for-testing",
    "package-for-testing": "node tasks/test/createBundles.js"
  },
  "dependencies": {
    "@adobe/reactor-validator": "^2.5.0",
    "archiver": "^7.0.1",
    "chalk": "^5.6.2",
    "glob": "^7.1.6",
    "ramda": "^0.27.0",
    "requires-regex": "^1.0.4",
    "yargs": "^18.0.0"
  },
  "bin": {
    "reactor-packager": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "rollup": "^4.52.2",
    "shx": "^0.3.3"
  }
}
